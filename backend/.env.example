# Placeholders only. Copy to .env (git-ignored) and adjust. Never commit real secrets.
APP_ENV=development
HOST=127.0.0.1
PORT=3000
DATABASE_PATH=./data/planner.db
# COOKIE_SECURE defaults to true when APP_ENV=production, else false
# COOKIE_SECURE=true
# Set true only behind a reverse proxy you control that overwrites X-Forwarded-For
TRUST_PROXY=false
SESSION_TTL_HOURS=168

# --- AI (optional): Hugging Face via LangChain, orchestrated with LangGraph ---
# Leave HF_TOKEN empty to run with AI disabled. Create a token at https://huggingface.co/settings/tokens
HF_TOKEN=
# Hugging Face model id served by Inference Providers (choose a chat/instruct model you have access to)
HF_MODEL_ID=
# Inference Providers routing: "auto" or a specific provider name
HF_PROVIDER=auto
# Optional: use a dedicated Inference Endpoint or a self-hosted TGI server instead of HF_MODEL_ID routing.
# https is required except for localhost. A localhost endpoint needs no token.
# HF_ENDPOINT_URL=http://localhost:8080
AI_TIMEOUT_SECONDS=30
AI_MAX_OUTPUT_TOKENS=2500
AI_DAILY_LIMIT=20
# How many times the LangGraph workflow may send validation feedback to the model (0-3)
AI_MAX_REPAIRS=2
