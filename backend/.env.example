# Placeholders only. Copy to .env (git-ignored) and adjust. Never commit real secrets.
APP_ENV=development
HOST=127.0.0.1
PORT=3000
DATABASE_PATH=./data/planner.db
# COOKIE_SECURE defaults to true when APP_ENV=production, else false
# COOKIE_SECURE=true
# Set true only behind a reverse proxy you control that overwrites X-Forwarded-For
TRUST_PROXY=false
SESSION_TTL_HOURS=168

# --- AI (optional): Gemini (free tier) or OpenAI via LangGraph ---
# Provider selection: "gemini", "openai", or "huggingface" (auto-detected from keys when left blank)
AI_PROVIDER=gemini

# Option 1 — Google Gemini (free tier available at https://aistudio.google.com/apikey):
GEMINI_API_KEY=
OPENAI_API_KEY=

# Option 3 — Legacy Hugging Face fallback (optional):
HF_TOKEN=
HF_MODEL_ID=
HF_PROVIDER=auto
# HF_ENDPOINT_URL=http://localhost:8080

AI_TIMEOUT_SECONDS=30
AI_MAX_OUTPUT_TOKENS=2500
AI_DAILY_LIMIT=20
# How many times the LangGraph workflow may send validation feedback to the model (0-3)
AI_MAX_REPAIRS=2
