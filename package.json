{
  "name": "event-planning-assistant",
  "version": "1.0.0",
  "private": true,
  "description": "Frontend tooling for the Event Planning Assistant (framework-free ES modules served by the FastAPI backend).",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "scripts": {
    "dev": "concurrently -k -n backend,frontend -c blue,green \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:backend": "cd backend && ..\\.venv\\Scripts\\python.exe -m app",
    "dev:frontend": "vite",
    "build": "vite build",
    "lint": "eslint frontend",
    "lint:fix": "eslint frontend --fix",
    "lint:backend": "ruff check backend tests",
    "format": "prettier --check \"frontend/**/*.{js,css,html}\"",
    "format:fix": "prettier --write \"frontend/**/*.{js,css,html}\"",
    "setup:backend": "python -m pip install -r backend/requirements-dev.txt",
    "setup": "npm install && npm run setup:backend",
    "test": "python -m pytest",
    "test:unit": "vitest run --coverage",
    "test:a11y": "playwright test",
    "audit": "npm audit",
    "audit:backend": "python -m pip_audit -r backend/requirements.txt"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.0",
    "@playwright/test": "^1.64.1",
    "@vitest/coverage-v8": "^5.1.0",
    "concurrently": "^9.0.0",
    "eslint": "^10.14.0",
    "globals": "^15.0.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.0.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "eslint": {
      "minimatch": "^11.0.1"
    }
  }
}
